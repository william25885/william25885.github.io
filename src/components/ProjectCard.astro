---
import TagList from './TagList.astro';

interface Props {
  id: string;
  title: string;
  summary: string;
  tags: string[];
}

const { id, title, summary, tags } = Astro.props;
---
<a class="project reveal" href={`/projects/${id}/`}>
  <h3>{title}</h3>
  <p>{summary}</p>
  <TagList tags={tags} />
</a>
