---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

const research = projects.filter((p) => p.data.category === 'research');
const systems = projects.filter((p) => p.data.category === 'systems');

const description =
  'Ting-Chen Cho — deep reinforcement learning, generative models and self-supervised representation learning. National Taiwan University.';
---
<BaseLayout title="Ting-Chen Cho" description={description}>
  <header class="page-header">
    <h1>Ting-Chen Cho</h1>
    <p class="zh">卓庭榛</p>
    <p class="intro">
      I'm a Public Health student at <strong>National Taiwan University</strong>, graduating in
      2027 — though not a very dutiful one.
    </p>
    <p class="links">
      <a href="https://github.com/william25885">GitHub</a>
      <a href="mailto:william25885@gmail.com">Email</a>
      <a href="/resume.pdf">CV</a>
    </p>
  </header>

  <section>
    <h2 class="reveal-rule">Research &amp; Machine Learning</h2>
    {research.map((p) => (
      <ProjectCard
        id={p.id}
        title={p.data.title}
        summary={p.data.summary}
        tags={p.data.tags}
        context={p.data.context}
      />
    ))}
  </section>

  <section>
    <h2 class="reveal-rule">Systems &amp; Software Engineering</h2>
    {systems.map((p) => (
      <ProjectCard
        id={p.id}
        title={p.data.title}
        summary={p.data.summary}
        tags={p.data.tags}
        context={p.data.context}
      />
    ))}
  </section>
</BaseLayout>
